#!/usr/bin/env bash
#
# Pre-commit hook: runs encoding and collision validation on staged files,
# mirroring the checks from .gitlab-ci.yml.
#

set -e

# Get staged files (Added, Copied, Modified, Renamed)
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED" ]; then
    echo "No staged files to check."
    exit 0
fi

CHANGED_TXT=$(echo "$STAGED" | grep -E '\.txt$' || true)
CHANGED_YML=$(echo "$STAGED" | grep -E '^localisation/.*\.yml$' || true)

FAIL=0

# --- encoding & indentation (.txt) ---
if [ -n "$CHANGED_TXT" ]; then
    echo "=== Checking encoding and indentation for changed .txt files ==="
    echo "$CHANGED_TXT"
    bash scripts/encoding.sh -t -i $CHANGED_TXT || FAIL=1
else
    echo "--- No .txt files staged, skipping ---"
fi

# --- encoding (.yml) ---
if [ -n "$CHANGED_YML" ]; then
    echo "=== Checking encoding for changed .yml files ==="
    echo "$CHANGED_YML"
    bash scripts/encoding.sh -l $CHANGED_YML || FAIL=1

    echo "=== Checking key collisions (all localisation files, to catch collisions with unchanged keys) ==="
    python3 scripts/hash_collision_detect.py || FAIL=1
else
    echo "--- No localisation files staged, skipping ---"
fi

if [ $FAIL -eq 1 ]; then
    echo ""
    echo "Pre-commit validation failed. Please fix the issues above before committing."
    exit 1
fi

echo ""
echo "Pre-commit validation passed."
exit 0
