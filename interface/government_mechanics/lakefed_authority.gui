guiTypes = {# Interactions, copied from government_interaction_type but we want a different size than default

	windowType = {
		name = "lakefed_authority_button"
		size = { x = 100 y = 78 }
		position = { x = 7 y = 10 }
		backGround = ""
		moveable = 0
		dontRender = ""
		horizontalBorder = ""
		Orientation = "UPPER_LEFT"

		### interaction button
		guiButtonType = {
			name = "government_interaction_button"
			quadTextureSprite = "GFX_russian_ability_ADM" #placeholder so we don't get an assert - you have to set something - but this will be overridden by the interaction's icon
			position = { x = 7 y = -10 }
			tooltip = ""
			tooltipText = ""
			delayedTooltipText = ""
			buttonFont = "vic_18"
			Orientation = "UPPER_LEFT"
			clicksound = back_click
			text = ""
		}
		
		#bar and frame for the power type associated with this interaction (if it's unique to the interaction - if not, these will be hidden)
		# iconType = { 
		# 	name = "government_power_bar"
		# 	spriteType = "GFX_government_power_bar"
		# 	position = { x = 20 y = 78 }
		# 	Orientation = "UPPER_LEFT"
		# }
		
		# iconType = {
		# 	name = "government_power_bar_frame"
		# 	spriteType = "GFX_government_power_bar_frame"
		# 	position = { x = 6 y = 73 }
		# 	Orientation = "UPPER_LEFT"
		# 	alwaystransparent = yes
		# }
	}

	windowType = { # Copied and adjusted from government_interaction_type
		name = "lakefed_authority_bar"
		size = { x = 204 y = 12 }
		moveable = 0

		# bar and frame for the power type associated with this interaction (if it's unique to the interaction - if not, these will be hidden)
		iconType = { 
			name = "government_power_bar"
			spriteType = "GFX_lakefed_authority_bar"
			# position = { x = 55 y = 89 }
			position = { x = 55 y = 78 }
		}	

		# Progressbar Frame
		iconType = {
			name = "frame_background"
			spriteType = "GFX_lakefed_authority_bar_frame"
			alwaystransparent = yes
			# position = { x = 55 y = 86 }
			position = { x = 6 y = 73 }
			# position = { x = 7 y = -99 }
		}
	}
}